{
  "folders": [
    {
      "name": "Dashboard",
      "path": "."
    },
    {
      "name": "Azure Functions",
      "path": "azure-functions"
    },
    {
      "name": "Data Pipeline",
      "path": "data-pipeline"
    },
    {
      "name": "Tracker PNL",
      "path": "tracker_pnl"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder:Dashboard}/data-pipeline/.venv/Scripts/python.exe",
    "python.analysis.autoImportCompletions": true,
    "azureFunctions.projectRuntime": "~4",
    "azureFunctions.projectLanguage": "JavaScript",
    "azureFunctions.deploySubpath": "azure-functions",
    "terminal.integrated.env.windows": {
      "PYTHONPATH": "${workspaceFolder:Dashboard}"
    },
    "cursorpyright.analysis.autoImportCompletions": true
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start Azurite",
        "type": "shell",
        "command": "azurite --silent --location .azurite --blobHost 127.0.0.1 --queueHost 127.0.0.1 --tableHost 127.0.0.1",
        "isBackground": true,
        "problemMatcher": "$azurite-blob"
      },
      {
        "label": "Start Dashboard Functions",
        "type": "shell",
        "command": "cd azure-functions && func start --port 7072",
        "dependsOn": "Start Azurite",
        "isBackground": true,
        "problemMatcher": "$func-watch"
      },
      {
        "label": "Start Local Dev",
        "type": "shell",
        "command": "powershell -ExecutionPolicy Bypass -File scripts/start-local-dev.ps1 -Port 7072",
        "problemMatcher": []
      }
    ]
  }
}