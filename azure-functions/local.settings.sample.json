    "NBA_API_URL": "https://YOUR-NBA-APP.azurecontainerapps.io",
    "NCAAM_API_URL": "https://YOUR-NCAAM-APP.azurecontainerapps.io",
    "NHL_API_URL": "https://YOUR-NHL-APP.azurecontainerapps.io",
    "NFL_API_URL": "https://YOUR-NFL-APP.azurecontainerapps.io",
    "NCAAF_API_URL": "https://YOUR-NCAAF-APP.azurecontainerapps.io",
    "MLB_API_URL": "https://YOUR-MLB-APP.azurecontainerapps.io",

