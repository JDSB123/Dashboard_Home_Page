{
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "dev:azurite": "azurite --silent --location .azurite --debug .azurite\\debug.log",
    "ingest-logos": "node scripts/ingest-all-logos.js",
    "ingest-logos:dry-run": "node scripts/ingest-all-logos.js --dry-run",
    "ingest-logos:local": "node scripts/ingest-all-logos.js --skip-upload"
  },
  "devDependencies": {
    "azurite": "^3.35.0"
  }
}
